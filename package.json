{
  "name": "emuplay",
  "version": "1.0.0",
  "type": "module",
  "description": "Rapid browser emulation environment using Playwright",
  "main": "index.js",
  "scripts": {
    "emu:chrome": "node scripts/emu-run.js \"Desktop Chrome\"",
    "emu:firefox": "node scripts/emu-run.js \"Desktop Firefox\"",
    "emu:safari": "node scripts/emu-run.js \"Desktop Safari\"",
    "emu:edge": "node scripts/emu-run.js \"Desktop Edge\"",
    "emu:linux": "node scripts/emu-run.js \"Desktop Linux\"",
    "emu:iphone": "node scripts/emu-run.js \"iPhone 13\"",
    "emu:iphone15": "node scripts/emu-run.js \"iPhone 15 Pro\"",
    "emu:iphone-chrome": "node scripts/emu-run.js \"iPhone Chrome\"",
    "emu:ipad": "node scripts/emu-run.js \"iPad (gen 7)\"",
    "emu:ipad-pro": "node scripts/emu-run.js \"iPad Pro\"",
    "emu:pixel": "node scripts/emu-run.js \"Pixel 7\"",
    "emu:galaxy": "node scripts/emu-run.js \"Galaxy S9+\"",
    "emu:galaxy24": "node scripts/emu-run.js \"Galaxy S24\"",
    "emu": "node scripts/emu-selector.js",
    "emu:ms": "node scripts/emu-multisession.js",
    "emu:list": "node scripts/emu-list.js",
    "emu:ui": "playwright test --ui"
  },
  "keywords": [
    "playwright",
    "emulation",
    "testing",
    "pnpm"
  ],
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5"
  }
}